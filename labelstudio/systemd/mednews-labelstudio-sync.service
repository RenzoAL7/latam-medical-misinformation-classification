[Unit]
Description=Synchronize MedNews Evidence CSVs from OCI Object Storage to Label Studio
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/mednews-labelstudio-sync.env

[Service]
Type=oneshot
User=opc
Group=opc
Environment=OBJECT_STORAGE_NAMESPACE=idur1kkrru56
Environment=OBJECT_STORAGE_BUCKET=mednews-data
Environment=OBJECT_STORAGE_PREFIX=silver/evidence
Environment=LABEL_STUDIO_URL=http://127.0.0.1:18080
Environment=LABEL_STUDIO_PROJECT_ID=5
EnvironmentFile=/etc/mednews-labelstudio-sync.env
WorkingDirectory=/home/opc/mednews-labelstudio-sync/app
ExecStart=/home/opc/mednews-labelstudio-sync/venv/bin/python /home/opc/mednews-labelstudio-sync/app/sync_evidence_from_object_storage.py --work-dir /home/opc/mednews-labelstudio-sync/state
