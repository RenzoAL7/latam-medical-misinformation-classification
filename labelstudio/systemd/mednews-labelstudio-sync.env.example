# Create /etc/mednews-labelstudio-sync.env with mode 0600.
# Store only a long-lived JWT refresh token. The sync creates a short-lived
# access token for each run, so the timer continues working after access-token
# expiration. Never commit either token.
LABEL_STUDIO_REFRESH_TOKEN=REPLACE_WITH_A_LABEL_STUDIO_JWT_REFRESH_TOKEN
