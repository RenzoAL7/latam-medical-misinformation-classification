[Unit]
Description=Poll OCI Object Storage for completed MedNews Evidence JSONL runs

[Timer]
# OnBootSec is already elapsed when this timer is enabled on a long-running
# VM, leaving it active without a next trigger.  Anchor the first poll to the
# timer activation itself, then wait five minutes after each completed sync.
OnActiveSec=2min
OnUnitInactiveSec=5min
Persistent=true
Unit=mednews-labelstudio-sync.service

[Install]
WantedBy=timers.target
