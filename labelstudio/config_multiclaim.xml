<View>
  <Style>
    .meta { background: #f5f7fa; border-radius: 8px; padding: 10px 14px; }
    .claim-card { background: #fff8e6; border-left: 4px solid #d99a00; border-radius: 8px; padding: 12px 16px; }
    .evidence-card { background: #f2f8ff; border-left: 4px solid #3578c6; border-radius: 8px; padding: 12px 16px; }
    .decision-card { background: #fafafa; border: 1px solid #d9dfe8; border-radius: 8px; padding: 12px 16px; }
    .meta, .meta *, .claim-card, .claim-card *, .evidence-card, .evidence-card *, .decision-card, .decision-card * { color: #182230 !important; }
    .small-note, .small-note * { color: #455468 !important; font-size: 0.9em; }
  </Style>

  <Header value="Revisión humana por claim médico" />
  <Markdown value="Cada tarea corresponde a un solo claim (`record_id + claim_id`). Embed 4 y TF-IDF ordenan artículos PubMed: no verifican por sí mismos que la noticia sea verdadera. Primero marca su importancia. Si es secundario, basta justificar por qué no cambia el sentido de la noticia; no completes el bloque de evidencia. Para claims centrales o materiales, revisa la evidencia y el veredicto." />

  <View className="meta" style="display: flex; gap: 16px;">
    <View style="flex: 1;">
      <Text name="record" value="Noticia: $record_id" />
      <Text name="claim-id" value="Claim: $claim_id" />
      <Text name="country" value="País: $country" />
      <Text name="published" value="Publicado: $published_at" />
    </View>
    <View style="flex: 2;">
      <Text name="source" value="Fuente: $source_name" />
      <Text name="title" value="Título: $title" />
      <Text name="url" value="URL original: $canonical_url" />
    </View>
  </View>

  <View className="claim-card">
    <Header value="Claim que debes verificar" />
    <Text name="claim" value="$claim_text" />
    <Text name="claim-type" value="Tipo detectado: $claim_type" />
    <Markdown value="Decide solo esta afirmación. La etiqueta final de la noticia se calcula después, al reunir todos sus claims centrales o materiales." />
  </View>

  <View className="evidence-card">
    <Header value="Mejor candidato PubMed" />
    <Text name="evidence_primary" value="$evidence_primary" />
  </View>

  <Collapse accordion="true" open="false">
    <Panel value="Ver candidatos PubMed adicionales">
      <Text name="evidence_additional" value="$evidence_additional" />
    </Panel>
    <Panel value="Detalles técnicos de recuperación">
      <View className="small-note">
        <Text name="query" value="Consulta PubMed: $pubmed_query_en" />
        <Text name="claim-en" value="Claim en inglés: $claim_text_en" />
        <Text name="status" value="Evidence: $evidence_status | Embed: $embedding_status | Traducción: $translation_status" />
        <Text name="scores" value="PMID mejor rankeado: $best_pmid | Score semántico de ese PMID (Embed 4): $best_embedding_similarity | Máximo TF-IDF entre candidatos: $best_tfidf_similarity" />
      </View>
    </Panel>
  </Collapse>

  <View className="decision-card">
    <Header value="1. Importancia de este claim para la noticia" />
    <Markdown value="Central = sostiene la conclusión de la noticia. Material = cambia de manera relevante su interpretación. Secundario = contexto que no cambia el veredicto final por sí solo." />
    <Choices name="claim_materiality" toName="claim" choice="single-radio" showInline="true" required="true">
      <Choice value="central" html="Central" />
      <Choice value="material" html="Material" />
      <Choice value="secondary" html="Secundario" />
    </Choices>

    <Header value="2. Relación entre evidencia y claim" />
    <Choices name="evidence_relation" toName="claim" choice="single-radio" showInline="true">
      <Choice value="supports" html="Apoya" />
      <Choice value="contradicts" html="Contradice" />
      <Choice value="unclear" html="No concluyente" />
    </Choices>

    <Header value="3. Veredicto de este claim" />
    <Choices name="claim_verdict" toName="claim" choice="single-radio" showInline="true">
      <Choice value="RESPALDADO" html="Respaldado" />
      <Choice value="REFUTADO" html="Refutado" />
      <Choice value="NO_DETERMINABLE" html="No determinable" />
    </Choices>
  </View>

  <Header value="PMID(s) usados (obligatorio para claims centrales/materiales con evidencia)" />
  <TextArea name="selected_pmids" toName="claim" maxSubmissions="1" placeholder="Para claims centrales/materiales con evidencia: por ejemplo 12345678, 23456789" />
  <Header value="Justificación humana (obligatoria)" />
  <TextArea name="verification_note" toName="claim" required="true" maxSubmissions="1" placeholder="Indica población, resultado y por qué la evidencia apoya, contradice o no permite decidir." />
</View>
