<View>
  <Style>
    /* Label Studio inherits white text in Dark mode. These cards keep a
       light surface, so their descendants need an explicit dark foreground. */
    .meta { background: #f5f7fa; border-radius: 8px; padding: 10px 14px; }
    .claim-card { background: #fff8e6; border-left: 4px solid #d99a00; border-radius: 8px; padding: 12px 16px; }
    .evidence-card { background: #f2f8ff; border-left: 4px solid #3578c6; border-radius: 8px; padding: 12px 16px; }
    .decision-card { background: #fafafa; border: 1px solid #d9dfe8; border-radius: 8px; padding: 12px 16px; }
    .meta, .meta *, .claim-card, .claim-card *, .evidence-card, .evidence-card *, .decision-card, .decision-card * { color: #182230 !important; }
    .small-note, .small-note * { color: #455468 !important; font-size: 0.9em; }
  </Style>

  <Header value="Revisión humana de evidencia médica LATAM" />
  <Markdown value="Revisa solamente tareas con evidencia PubMed disponible. Lee el claim, verifica el PMID y decide con criterio humano: las similitudes de Embed 4 y TF-IDF solo ordenan candidatos; no son probabilidades ni etiquetas automáticas." />

  <View className="meta" style="display: flex; gap: 16px;">
    <View style="flex: 1;">
      <Text name="record" value="Registro: $record_id" />
      <Text name="country" value="País: $country" />
      <Text name="published" value="Publicado: $published_at" />
    </View>
    <View style="flex: 2;">
      <Text name="source" value="Fuente: $source_name" />
      <Text name="title" value="Título: $title" />
      <Text name="url" value="URL original: $canonical_url" />
    </View>
  </View>

  <View className="claim-card">
    <Header value="Claim que debes verificar" />
    <Text name="claim" value="$claim_text" />
    <Markdown value="No clasifiques el titular completo: decide únicamente sobre esta afirmación médica concreta." />
  </View>

  <View className="evidence-card">
    <Header value="Evidencia principal" />
    <Text name="evidence_primary" value="$evidence_primary" />
    <Markdown value="Confirma que el PMID, la población y el resultado del estudio respondan al claim antes de decidir." />
  </View>

  <Collapse accordion="true" open="false">
    <Panel value="Ver otros candidatos PubMed">
      <View>
        <Text name="evidence_additional" value="$evidence_additional" />
      </View>
    </Panel>
  </Collapse>

  <Collapse accordion="true" open="false">
    <Panel value="Detalles técnicos de la búsqueda">
      <View className="small-note">
        <Text name="query" value="Consulta PubMed (inglés): $pubmed_query_en" />
        <Text name="claim-en" value="Claim en inglés: $claim_text_en" />
        <Text name="status" value="Estado: $evidence_status | Candidatos: $evidence_count" />
        <Text name="scores" value="Mejor PMID: $best_pmid | Embed 4: $best_embedding_similarity | TF-IDF: $best_tfidf_similarity (solo ranking)" />
        <Text name="run" value="Evidence run: $evidence_run_id" />
      </View>
    </Panel>
  </Collapse>

  <View className="decision-card" style="display: flex; gap: 24px;">
    <View style="flex: 1;">
      <Header value="¿Qué relación tiene la evidencia con el claim?" />
      <Markdown value="Apoya = respalda el claim. Contradice = muestra lo contrario. No concluyente = la evidencia disponible no permite decidir. Para una noticia excluida, selecciona No concluyente y explica el motivo." />
      <Choices name="evidence_relation" toName="claim" choice="single-radio" showInline="true" required="true" requiredMessage="Selecciona una relación.">
        <Choice value="supports" html="Apoya" hint="La evidencia respalda el claim." />
        <Choice value="contradicts" html="Contradice" hint="La evidencia muestra lo contrario." />
        <Choice value="unclear" html="No concluyente" hint="No permite confirmar ni refutar." />
      </Choices>
    </View>
    <View style="flex: 1;">
      <Header value="Etiqueta final de la noticia" />
      <Choices name="final_label" toName="claim" choice="single-radio" showInline="true" required="true" requiredMessage="Selecciona una etiqueta final.">
        <Choice value="RESPALDADA" hint="La evidencia respalda el claim; candidata para el Gold binario." />
        <Choice value="REFUTADA" hint="La evidencia contradice el claim; candidata para el Gold binario." />
        <Choice value="NO_DETERMINABLE" hint="La evidencia no alcanza para decidir; queda solo para auditoría." />
        <Choice value="EXCLUIDA" hint="La noticia no es apta para el corpus; queda solo para auditoría." />
      </Choices>
    </View>
  </View>

  <Header value="Justificación humana (obligatoria)" />
  <TextArea name="verification_note" toName="claim" required="true" maxSubmissions="1" placeholder="Indica el PMID usado, población o resultado relevante y explica por qué la evidencia apoya, contradice o no permite decidir. Si excluyes, indica la causa." />
</View>